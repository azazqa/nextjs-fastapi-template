# Local database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mydatabase

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/testdatabase

# Database connection pool (per Gunicorn worker process)
# Max DB connections ≈ GUNICORN_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Gunicorn worker count (gunicorn.conf.py → process env GUNICORN_WORKERS)
# Docker Compose backend는 env_file로 이 값을 주입; 변경 후 `docker compose up -d --force-recreate backend`
GUNICORN_WORKERS=1

# Secret keys
ACCESS_SECRET_KEY=your_access_secret_key
RESET_PASSWORD_SECRET_KEY=your_reset_password_secret_key
VERIFICATION_SECRET_KEY=your_verification_secret_key
REFRESH_SECRET_KEY=your_refresh_secret_key

# Refresh cookie Secure flag (set true in production HTTPS)
COOKIE_SECURE=false

# Login rate limit (per login id)
# x sec window: y+ failed attempts → z sec lockout
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=60

# Redis (login rate limit across Gunicorn workers; unset → in-memory fallback for tests)
REDIS_URL=redis://localhost:6379/0

# OpenAPI genrated file output path
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

# Localhost Email configuration
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@test.com
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# Frontend (NextJS)
FRONTEND_URL=http://localhost:3000

# CORS (Allow all origins for development; adjust this to restrict origins in production deployments)
CORS_ORIGINS=["*"]

# OPENAPI (Uncomment the line below to disable the /docs and openapi.json urls)
# OPENAPI_URL=""